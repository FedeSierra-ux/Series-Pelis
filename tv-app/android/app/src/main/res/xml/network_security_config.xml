<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo se habilita http para el motor de torrents de la app (TorrentServer), que escucha en
  127.0.0.1: el reproductor nativo le pide el video por http a ese puerto local. Sin base-config a
  propósito: lo demás queda como el valor de fábrica de cada versión (en Android 7/8 http sigue
  permitido, como antes, y había fuentes http:// que andaban; desde el 9 ya viene en false).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
