# Cloudflare Pages. Los archivos de /assets llevan un hash en el nombre: se pueden guardar para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# El service worker y el manifiesto se revisan en cada visita, así las actualizaciones llegan enseguida.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Cabeceras de seguridad para todo el sitio.
# - CSP: la app es un cliente genérico de addons, así que imágenes, video, audio, subtítulos y manifests
#   pueden venir de cualquier host (img/media/connect-src *). Scripts solo del sitio, sin ninguno inline (desde
#   la v0.11 el tema va fijo en index.html; src/lib/securityHeaders.test.ts avisa si aparece uno). Estilos
#   inline: React los usa.
#   frame-src: solo el tráiler de YouTube (HoverTrailer, TmdbHero). Workers: el service worker y los blob de hls.js.
# - Permissions-Policy: cámara, micrófono y ubicación apagados; autoplay, pantalla completa y PiP para la app
#   y para el iframe del tráiler de YouTube (sin eso el tráiler no arranca solo).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), autoplay=(self "https://www.youtube.com" "https://www.youtube-nocookie.com"), fullscreen=(self "https://www.youtube.com" "https://www.youtube-nocookie.com"), picture-in-picture=(self "https://www.youtube.com" "https://www.youtube-nocookie.com")
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src * data: blob:; media-src * data: blob:; connect-src * data: blob:; font-src 'self' data:; worker-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
